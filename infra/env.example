# ============================================================
# PledgeOFF — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local
# ============================================================

# --- Supabase (dev) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- LLM provider — set LLM_PROVIDER=anthropic to use Claude instead of Groq ---
LLM_PROVIDER=groq

# --- Groq (LLM, Tier 1 default) ---
GROQ_API_KEY=<groq-api-key>

# --- Anthropic (LLM, Tier 2 / optional) ---
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Product Hunt (signal ingestion) ---
PRODUCT_HUNT_API_KEY=<product-hunt-api-key>
PRODUCT_HUNT_API_SECRET=<product-hunt-api-secret>

# --- Google Custom Search (Reddit via site:reddit.com) — disabled, replaced by Brave ---
# GOOGLE_SEARCH_API_KEY=<google-custom-search-api-key>
# GOOGLE_SEARCH_ENGINE_ID=<google-custom-search-engine-id>

# --- Brave Search (Reddit via site:reddit.com, 2000 free req/month) ---
BRAVE_SEARCH_API_KEY=<brave-search-api-key>

# --- Cache (Tier 1: memory, Tier 2: redis) ---
CACHE_PROVIDER=memory
# CACHE_PROVIDER=redis
# UPSTASH_REDIS_REST_URL=https://<endpoint>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

# --- Observability ---
SENTRY_DSN=<sentry-dsn>
AXIOM_TOKEN=<axiom-token>
AXIOM_DATASET=pledgeoff-dev

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Webhooks (Supabase Database Webhooks) ---
# Generate with: openssl rand -hex 32
# Add same value in Supabase Dashboard → Database → Webhooks → HTTP Headers: Authorization: Bearer <value>
WEBHOOK_SECRET=<webhook-secret>

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx

# --- Analytics & SEO ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_OG_BASE_URL=https://pledgeoff.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_<secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<webhook-secret>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<publishable-key>
STRIPE_PRO_MONTHLY_PRICE_ID=price_<pro-monthly>
STRIPE_PRO_ANNUAL_PRICE_ID=price_<pro-annual>
STRIPE_PRO_PLUS_MONTHLY_PRICE_ID=price_<pro-plus-monthly>
STRIPE_PRO_PLUS_ANNUAL_PRICE_ID=price_<pro-plus-annual>
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=price_<pro-monthly>
NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID=price_<pro-annual>
NEXT_PUBLIC_STRIPE_PRO_PLUS_MONTHLY_PRICE_ID=price_<pro-plus-monthly>
NEXT_PUBLIC_STRIPE_PRO_PLUS_ANNUAL_PRICE_ID=price_<pro-plus-annual>
# Extra seat add-on (€7/seat/month) — server-side only, no NEXT_PUBLIC_ needed
STRIPE_EXTRA_SEAT_PRICE_ID=price_<extra-seat-monthly>
