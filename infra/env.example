# ============================================================
# PledgeOFF — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local
# ============================================================

# --- Supabase (dev) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- LLM provider — set LLM_PROVIDER=anthropic to use Claude instead of Groq ---
LLM_PROVIDER=groq

# --- Groq (LLM, Tier 1 default) ---
GROQ_API_KEY=<groq-api-key>

# --- Anthropic (LLM, Tier 2 / optional) ---
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Reddit (signal ingestion) ---
REDDIT_CLIENT_ID=<reddit-client-id>
REDDIT_CLIENT_SECRET=<reddit-client-secret>

# --- GitHub (signal ingestion) ---
GITHUB_PAT=<personal-access-token>

# --- Cache (Tier 1: memory, Tier 2: redis) ---
CACHE_PROVIDER=memory
# CACHE_PROVIDER=redis
# UPSTASH_REDIS_REST_URL=https://<endpoint>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

# --- Observability ---
SENTRY_DSN=<sentry-dsn>
AXIOM_TOKEN=<axiom-token>
AXIOM_DATASET=pledgeoff-dev

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Webhooks (Supabase Database Webhooks) ---
# Generate with: openssl rand -hex 32
# Add same value in Supabase Dashboard → Database → Webhooks → HTTP Headers: Authorization: Bearer <value>
WEBHOOK_SECRET=<webhook-secret>

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx

# --- Analytics & SEO ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_OG_BASE_URL=https://pledgeoff.com
