# ============================================================
# PledgeOFF — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local
# ============================================================

# --- Supabase (dev) ---
# Dev project ref: vayqlprmwtvwqfxdfygl  ← must match .env.local
# Prod project ref: gphupxlfmeokquvyxqfw ← Vercel only, NEVER in .env.local
NEXT_PUBLIC_SUPABASE_URL=https://vayqlprmwtvwqfxdfygl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- LLM provider — set LLM_PROVIDER=anthropic to use Claude instead of Groq ---
LLM_PROVIDER=groq

# --- Groq (LLM, Tier 1 default) ---
GROQ_API_KEY=<groq-api-key>

# --- Anthropic (LLM, Tier 2 / optional) ---
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Product Hunt (signal ingestion) ---
PRODUCT_HUNT_API_KEY=<product-hunt-api-key>
PRODUCT_HUNT_API_SECRET=<product-hunt-api-secret>

# --- Google Custom Search (Reddit via site:reddit.com) — disabled, replaced by Brave ---
# GOOGLE_SEARCH_API_KEY=<google-custom-search-api-key>
# GOOGLE_SEARCH_ENGINE_ID=<google-custom-search-engine-id>

# --- Brave Search (Reddit via site:reddit.com, 2000 free req/month) ---
BRAVE_SEARCH_API_KEY=<brave-search-api-key>

# --- Cache (Tier 1: memory, Tier 2: redis) ---
CACHE_PROVIDER=memory
# CACHE_PROVIDER=redis
# UPSTASH_REDIS_REST_URL=https://<endpoint>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>

# --- Observability ---
SENTRY_DSN=<sentry-dsn>
AXIOM_TOKEN=<axiom-token>
AXIOM_DATASET=pledgeoff-dev

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Webhooks (Supabase Database Webhooks) ---
# Generate with: openssl rand -hex 32
# Add same value in Supabase Dashboard → Database → Webhooks → HTTP Headers: Authorization: Bearer <value>
WEBHOOK_SECRET=<webhook-secret>

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx

# --- Analytics & SEO ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_OG_BASE_URL=https://pledgeoff.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_<secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<webhook-secret>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<publishable-key>

# Subscription plans — monthly + annual
STRIPE_FOUNDER_MONTHLY_PRICE_ID=price_<founder-monthly>
STRIPE_FOUNDER_ANNUAL_PRICE_ID=price_<founder-annual>
NEXT_PUBLIC_STRIPE_FOUNDER_MONTHLY_PRICE_ID=price_<founder-monthly>
NEXT_PUBLIC_STRIPE_FOUNDER_ANNUAL_PRICE_ID=price_<founder-annual>

STRIPE_TEAM_MONTHLY_PRICE_ID=price_<team-monthly>
STRIPE_TEAM_ANNUAL_PRICE_ID=price_<team-annual>
NEXT_PUBLIC_STRIPE_TEAM_MONTHLY_PRICE_ID=price_<team-monthly>
NEXT_PUBLIC_STRIPE_TEAM_ANNUAL_PRICE_ID=price_<team-annual>

STRIPE_STUDIO_MONTHLY_PRICE_ID=price_<studio-monthly>
STRIPE_STUDIO_ANNUAL_PRICE_ID=price_<studio-annual>
NEXT_PUBLIC_STRIPE_STUDIO_MONTHLY_PRICE_ID=price_<studio-monthly>
NEXT_PUBLIC_STRIPE_STUDIO_ANNUAL_PRICE_ID=price_<studio-annual>

# Extra seat add-on — €20/seat/mo (Team + Studio)
STRIPE_EXTRA_SEAT_PRICE_ID=price_<extra-seat-monthly>

# Otto AI packs — one-time (10 / 25 / 60 / 150 întrebări)
STRIPE_OTTO_10Q_PRICE_ID=price_<otto-10q>
STRIPE_OTTO_25Q_PRICE_ID=price_<otto-25q>
STRIPE_OTTO_60Q_PRICE_ID=price_<otto-60q>
STRIPE_OTTO_150Q_PRICE_ID=price_<otto-150q>

# Validation packs — one-time (10 / 25 / 60 validări)
STRIPE_VALIDATION_PACK_10_PRICE_ID=price_<val-10>
STRIPE_VALIDATION_PACK_25_PRICE_ID=price_<val-25>
STRIPE_VALIDATION_PACK_60_PRICE_ID=price_<val-60>
