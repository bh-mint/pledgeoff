# Copy to .env.local. Use only a separate Supabase development project locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: immutable UUID and email of the privately provisioned Auth user.
# The login alias is bashui; this mapping must stay out of client bundles.
PRIVATE_TERMINAL_USER_ID=
PRIVATE_TERMINAL_EMAIL=
PRIVATE_TERMINAL_ORIGIN=http://localhost:3000

# Required for login in production; optional in local development (memory fallback).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
